# Copy this file to .env and edit locally. Do not paste passwords into chat.
AGENT_EMAIL=
MAIL_USERNAME=
MAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465
POLL_SECONDS=30
MAX_MESSAGE_BYTES=20000000
# Optional comma-separated addresses. Empty allows any non-automated sender.
ALLOWED_SENDERS=
# Leave blank for Playwright's installed Chromium, or set chrome / msedge.
BROWSER_CHANNEL=
# Optional: --ai sends request text to OpenAI for classification.
OPENAI_API_KEY=
OPENAI_MODEL=

# Blank for a dedicated inbox; set [Regulatory Agent] for a personal inbox.
SUBJECT_PREFIX=
